  "Dialogue": {
    "Type": "Complex",
    "SimpleDialogueLines": [],
    "ComplexDialogueTree": {
      "StartNodeId": "start",
      "Nodes": {
        "start": {
          "Id": "start",
          "Text": "Hey there! I'm Bailey, and I run the development house around here. Always happy to chat!",
          "Choices": [
            {
              "Text": "Tell me about the development house",
              "NextNodeId": "devhouse",
              "RequiredFlag": null,
              "SetFlag": null
            },
            {
              "Text": "Are you in the office today?",
              "NextNodeId": "office_status",
              "RequiredFlag": null,
              "SetFlag": null
            },
            {
              "Text": "Any game development tips?",
              "NextNodeId": "gamedev",
              "RequiredFlag": null,
              "SetFlag": null
            }
          ],
          "NextNodeId": null,
          "IsEndNode": false
        },
        "devhouse": {
          "Id": "devhouse",
          "Text": "DevHou.se is where I blog about game development, tech experiments, and creative projects. It's a place where code meets creativity!",
          "Choices": [
            {
              "Text": "How do blog posts become NPCs?",
              "NextNodeId": "blog_npcs",
              "RequiredFlag": null,
              "SetFlag": null
            },
            {
              "Text": "What kind of projects do you work on?",
              "NextNodeId": "projects",
              "RequiredFlag": null,
              "SetFlag": null
            },
            {
              "Text": "That's interesting!",
              "NextNodeId": "end_positive",
              "RequiredFlag": null,
              "SetFlag": null
            }
          ],
          "NextNodeId": null,
          "IsEndNode": false
        },
        "office_status": {
          "Id": "office_status",
          "Text": "Let me check... I'm currently {{OFFICE_STATUS}}.",
          "Choices": [
            {
              "Text": "How can I check your office status?",
              "NextNodeId": "check_status",
              "RequiredFlag": null,
              "SetFlag": null
            },
            {
              "Text": "Do you prefer the office or remote?",
              "NextNodeId": "work_preference",
              "RequiredFlag": null,
              "SetFlag": null
            }
          ],
          "NextNodeId": null,
          "IsEndNode": false
        },
        "gamedev": {
          "Id": "gamedev",
          "Text": "Always start with a simple prototype! This whole world started as a basic pixel art experiment. Don't be afraid to iterate and improve as you go.",
          "Choices": [
            {
              "Text": "What engine do you use?",
              "NextNodeId": "engine",
              "RequiredFlag": null,
              "SetFlag": null
            },
            {
              "Text": "Any advice for beginners?",
              "NextNodeId": "beginner_advice",
              "RequiredFlag": null,
              "SetFlag": null
            },
            {
              "Text": "Thanks for the tip!",
              "NextNodeId": "end_positive",
              "RequiredFlag": null,
              "SetFlag": null
            }
          ],
          "NextNodeId": null,
          "IsEndNode": false
        },
        "blog_npcs": {
          "Id": "blog_npcs",
          "Text": "It's pretty cool! Each blog post gets analyzed by AI to generate a unique personality, then ElevenLabs creates a voice for them. They become living characters in this world!",
          "Choices": [],
          "NextNodeId": "blog_npcs_2",
          "IsEndNode": false
        },
        "blog_npcs_2": {
          "Id": "blog_npcs_2",
          "Text": "So every NPC you meet here might have started as an idea, a project, or a story from the blog. It's like giving digital life to creativity!",
          "Choices": [
            {
              "Text": "That's amazing!",
              "NextNodeId": "end_positive",
              "RequiredFlag": null,
              "SetFlag": null
            },
            {
              "Text": "Tell me more about your projects",
              "NextNodeId": "projects",
              "RequiredFlag": null,
              "SetFlag": null
            }
          ],
          "NextNodeId": null,
          "IsEndNode": false
        },
        "projects": {
          "Id": "projects",
          "Text": "I work on everything from web apps to game development, AI experiments to creative coding. This game itself is one of my favorite projects - a living portfolio!",
          "Choices": [],
          "NextNodeId": null,
          "IsEndNode": true
        },
        "check_status": {
          "Id": "check_status",
          "Text": "You can visit isbaileybutlerintheoffice.today - it's a simple API that returns whether I'm physically in the office. Some NPCs here even check it!",
          "Choices": [],
          "NextNodeId": null,
          "IsEndNode": true
        },
        "work_preference": {
          "Id": "work_preference",
          "Text": "I enjoy both! The office is great for collaboration, but remote work gives me flexibility. This virtual world is kind of the best of both - always accessible from anywhere!",
          "Choices": [],
          "NextNodeId": null,
          "IsEndNode": true
        },
        "engine": {
          "Id": "engine",
          "Text": "This game is built with Godot 3.6! It's a fantastic open-source engine. The mix of C# and GDScript gives a lot of flexibility.",
          "Choices": [
            {
              "Text": "Why Godot?",
              "NextNodeId": "why_godot",
              "RequiredFlag": null,
              "SetFlag": null
            },
            {
              "Text": "Thanks!",
              "NextNodeId": "end_positive",
              "RequiredFlag": null,
              "SetFlag": null
            }
          ],
          "NextNodeId": null,
          "IsEndNode": false
        },
        "why_godot": {
          "Id": "why_godot",
          "Text": "Godot is free, open-source, and exports to web perfectly. Plus, the node system is intuitive and the community is amazing. Perfect for indie developers!",
          "Choices": [],
          "NextNodeId": null,
          "IsEndNode": true
        },
        "beginner_advice": {
          "Id": "beginner_advice",
          "Text": "Start small, finish projects, and share your work! Don't worry about making everything perfect. This game has evolved so much from its first version.",
          "Choices": [],
          "NextNodeId": "beginner_advice_2",
          "IsEndNode": false
        },
        "beginner_advice_2": {
          "Id": "beginner_advice_2",
          "Text": "Also, join communities, ask questions, and help others. Game development is more fun when you're learning together!",
          "Choices": [],
          "NextNodeId": null,
          "IsEndNode": true
        },
        "end_positive": {
          "Id": "end_positive",
          "Text": "Glad I could help! Feel free to explore the world and chat with the other NPCs. They all have their own stories to tell!",
          "Choices": [],
          "NextNodeId": null,
          "IsEndNode": true
        }
      }
    },
    "ConditionalDialogue": {
      "morning": ["Good morning! Early bird gets the bug fixed!"],
      "evening": ["Working late? Me too! The best code happens after midnight."],
      "first_meeting": ["Welcome to DevHou.se! I don't think we've met before."]
