{
  "Id": "{{unique_id_lowercase_no_spaces}}",
  "Name": "{{Character Name}}",
  "Description": "{{One sentence description of the character}}",
  "Personality": "{{Personality traits separated by commas}}",
  "BackgroundStory": "{{2-3 sentences about the character's background, motivations, and role in the game world}}",
  "Visual": {
    "SpriteSheetPath": "res://Assets/16x16/{{sprite_name}}_spritesheet.tres",
    "PortraitPath": "{{optional_portrait_path}}",
    "Scale": 1.0,
    "TintColor": "#FFFFFF",
    "AnimationOverrides": {
      "{{animation_name}}": "{{custom_animation_path}}"
    },
    "UseCustomShader": false,
    "CustomShaderPath": ""
  },
  "Behavior": {
    "EnableFullInteraction": true,
    "CaresAboutBaileyButlerOfficeStatus": false,
    "InteractionRadius": 32.0,
    "CanBePickedUp": false,
    "ReactsToWeather": true,
    "ReactsToTimeOfDay": true,
    "CustomFlags": ["{{tag1}}", "{{tag2}}"],
    "CustomProperties": {
      "{{property_key}}": "{{property_value}}"
    }
  },
  "Dialogue": {
    "Type": "Simple",
    "SimpleDialogueLines": [
      "{{Introduction line}}",
      "{{Personality showcase line}}",
      "{{Topic of interest line}}",
      "{{Engaging question for player}}",
      "{{Wisdom or advice}}",
      "{{Catchphrase or memorable quote}}"
    ],
    "ComplexDialogueTree": null,
    "ConditionalDialogue": {
      "{{condition}}": ["{{contextual_response}}"]
    },
    "CollisionResponses": {
      "default": "{{bump_response}}",
      "{{custom_state}}": "{{state_specific_response}}"
    },
    "DefaultGreeting": "{{greeting}}",
    "DefaultFarewell": "{{farewell}}",
    "TextDisplaySpeed": 0.05,
    "UseTypewriterEffect": true
  },
  "Movement": {
    "Pattern": "Random",
    "MoveSpeed": 50.0,
    "WaitTimeBetweenMoves": 3.0,
    "PatrolPoints": [],
    "CanChasePlayer": false,
    "ChaseSpeed": 100.0,
    "ChaseRadius": 150.0,
    "AvoidObstacles": true,
    "MovementModifiers": {
      "{{mood}}": {{speed_multiplier}}
    }
  },
  "Audio": {
    "VoiceId": "{{elevenlabs_voice_id}}",
    "VoicePitch": 1.0,
    "VoiceVolume": 1.0,
    "SoundEffects": {
      "{{sound_name}}": "res://Audio/SFX/{{sound_file}}.ogg"
    },
    "FootstepSound": "res://Audio/SFX/footstep_normal.ogg",
    "InteractionSound": "res://Audio/SFX/interaction_start.ogg",
    "EnableVoiceSynthesis": true
  },
  "GameData": {
    "SpawnLocation": "{{location_name}}",
    "SpawnWorld": "World",
    "RequiredItems": [],
    "GivesItems": ["{{item_id}}"],
    "Stats": {
      "{{stat_name}}": {{stat_value}}
    },
    "QuestIds": ["{{quest_id}}"],
    "IsMerchant": false,
    "ShopInventory": []
  },
  "Metadata": {
    "CreatedBy": "AI",
    "CreatedAt": "{{iso_datetime}}",
    "BlogPostUrl": "{{source_blog_url}}",
    "BlogPostTitle": "{{blog_post_title}}",
    "Tags": ["{{tag1}}", "{{tag2}}", "{{tag3}}"],
    "Version": "1.0.0",
    "AdditionalData": {
      "{{key}}": "{{value}}"
    }
  }
}